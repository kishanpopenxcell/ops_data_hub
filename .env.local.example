# Supabase (see https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# HubSpot OAuth app (developers.hubspot.com) -- leave blank while using mock data
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/callback

# Toggle mock HubSpot data instead of live API calls (default true until sandbox portal ready)
USE_MOCK_HUBSPOT=true
